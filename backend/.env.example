# ==============================================================================
# Sharink API - Environment Configuration Example
# ==============================================================================

# PostgreSQL database connection URL with asyncpg driver
DATABASE_URL=postgresql+asyncpg://sharink:sharink@localhost:5432/sharink

# Database container credentials (docker-compose)
POSTGRES_USER=sharink
POSTGRES_PASSWORD=sharink
POSTGRES_DB=sharink

# Secret key for cryptographic signing (tokens, session validation)
# In production, generate a secure random string (e.g., openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment: dev | test | prod
ENV=dev

# Default demo user UUID for development (used until full JWT auth is implemented)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
